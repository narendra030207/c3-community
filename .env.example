# ==============================================
# C3 COMMUNITY — ENVIRONMENT CONFIGURATION
# ==============================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# ── Database ──
# PostgreSQL connection string (Neon, Supabase, local)
DATABASE_URL="postgresql://user:password@host:5432/c3community?sslmode=require"

# ── Authentication (NextAuth v5) ──
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"

# Full URL of your deployment (localhost for dev)
NEXTAUTH_URL="http://localhost:3000"

# ── App Configuration ──
# Public-facing URL of the app (used for OG tags, canonical URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
